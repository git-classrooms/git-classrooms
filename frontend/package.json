{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"yarn dev:tsr\" \"yarn dev:vite\"",
    "dev:tsr": "tsr watch",
    "dev:vite": "vite",
    "build": "tsc && vite build",
    "generate": "cd ../ && ./script/swagger-codegen.sh",
    "lint": "tsc && eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "format": "prettier --write .",
    "clean": "rm -rf ./dist"
  },
